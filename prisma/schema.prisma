generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  message     String
  role        Role
  submittedAt DateTime @default(now())
}

enum Role {
  student
  teacher
}
